{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Gw2LegendaryTracker.slnx"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/tests/Gw2LegendaryTracker.Tests"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "publish (self-contained win-x64)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish", "${workspaceFolder}/src/Gw2LegendaryTracker.App",
        "-c", "Release", "-r", "win-x64", "--self-contained",
        "-o", "${workspaceFolder}/artifacts/win-x64"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "package (script)",
      "command": "pwsh",
      "type": "process",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1"],
      "problemMatcher": []
    }
  ]
}
