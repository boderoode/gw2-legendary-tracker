<Window x:Class="Gw2LegendaryTracker.App.Views.FashionStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gw2LegendaryTracker.App.Views"
        Title="Fashion Studio"
        Width="1280" Height="800" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="OnLoaded">
    <Window.Resources>
        <!-- A whole row is one big button: one click puts the skin on the character. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A slot card on the look board: gold outline when it is the selected slot. -->
        <Style x:Key="SlotCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="2" CornerRadius="8" Padding="12" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A colour square. The colour is the background; the name is in the tooltip and the screen reader name. -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Left: the browser of all skins that fit the selected slot. -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource HeadingText}">
                            <Run Text="Kies een skin:" />
                            <Run Text="{Binding SlotTitle, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SkinCountText}" Style="{StaticResource MutedText}" Margin="0,2,0,10" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Zoek een skin op naam" ToolTip="Zoek op naam" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <CheckBox Content="Alleen wat ik heb ontgrendeld" IsChecked="{Binding OwnedOnly, Mode=TwoWay}" />
                        <CheckBox Content="Ook skins tonen die niet passen bij mijn ras of klasse" IsChecked="{Binding ShowAllSkins, Mode=TwoWay}" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="{Binding OwnershipText}" Style="{StaticResource MutedText}" Margin="0,8,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="HasOwnershipText" Converter="{x:Static local:VisibilityConverter.Instance}" />
                        </TextBlock.Visibility>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Text="Geen skins gevonden. Pas je zoekopdracht of de filters aan." Style="{StaticResource MutedText}" Margin="0,12,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="HasNoSkins" Converter="{x:Static local:VisibilityConverter.Instance}" />
                        </TextBlock.Visibility>
                    </TextBlock>

                    <ListBox Grid.Row="4" ItemsSource="{Binding VisibleSkins}" Margin="0,10,0,0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             AutomationProperties.Name="Skins">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}"
                                        Command="{Binding DataContext.ApplySkinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Name}"
                                        ToolTip="{Binding Detail}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding IconUrl}" Width="40" Height="40" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding OwnedText}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Middle: the look board and the skin that is selected. -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingText}" FontSize="20">
                        <Run Text="Jouw look:" />
                        <Run Text="{Binding SelectedRace, Mode=OneWay}" />
                        <Run Text="{Binding SelectedGender, Mode=OneWay}" />
                        <Run Text="{Binding SelectedProfession, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                               Text="Kies een onderdeel en daarna links een skin. Kleuren kies je rechts." />

                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SlotCardButton}"
                                        Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Slot}"
                                        AutomationProperties.Name="{Binding Label}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="56" Height="56" CornerRadius="8" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Image Source="{Binding IconUrl}" Margin="2" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding SkinName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0">
                                            <TextBlock.Visibility>
                                                <Binding Path="HasWarning" Converter="{x:Static local:VisibilityConverter.Instance}" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Dyes}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="18" Height="18" Margin="0,0,4,0" CornerRadius="9" Background="{Binding Fill}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="{Binding Tooltip}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource CardBorder}" Margin="4,12,4,0">
                        <StackPanel>
                            <StackPanel>
                                <StackPanel.Visibility>
                                    <Binding Path="HasDetail" Converter="{x:Static local:VisibilityConverter.Instance}" />
                                </StackPanel.Visibility>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="112" Height="112" CornerRadius="8" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Detail.IconUrl}" Margin="4" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Detail.Name}" Style="{StaticResource HeadingText}" />
                                        <TextBlock Text="{Binding Detail.Facts}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Detail.Description}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="Dit onderdeel is nog leeg. Kies links een skin om hem hier te zien." Style="{StaticResource MutedText}">
                                <TextBlock.Visibility>
                                    <Binding Path="HasNoDetail" Converter="{x:Static local:VisibilityConverter.Instance}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource MutedText}" Margin="4,12,4,0"
                               Text="Dit is een 2D-voorbeeld met de iconen en kleuren uit de officiële Guild Wars 2-gegevens. Een 3D-weergave is onderzocht; zie docs/character-viewer-feasibility.md." />
                </StackPanel>
            </ScrollViewer>

            <!-- Right: character, dyes, saved looks and import. -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Karakter" Style="{StaticResource HeadingText}" />
                            <TextBlock Text="Ras" Style="{StaticResource MutedText}" Margin="0,8,0,2" />
                            <ComboBox ItemsSource="{Binding Races}" SelectedItem="{Binding SelectedRace, Mode=TwoWay}" Padding="6" AutomationProperties.Name="Ras" />
                            <TextBlock Text="Geslacht" Style="{StaticResource MutedText}" Margin="0,8,0,2" />
                            <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding SelectedGender, Mode=TwoWay}" Padding="6" AutomationProperties.Name="Geslacht" />
                            <TextBlock Text="Klasse" Style="{StaticResource MutedText}" Margin="0,8,0,2" />
                            <ComboBox ItemsSource="{Binding Professions}" SelectedItem="{Binding SelectedProfession, Mode=TwoWay}" Padding="6" AutomationProperties.Name="Klasse" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeadingText}">
                                <Run Text="Kleuren:" />
                                <Run Text="{Binding SlotTitle, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ChannelHint}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />

                            <StackPanel>
                                <StackPanel.Visibility>
                                    <Binding Path="HasChannels" Converter="{x:Static local:VisibilityConverter.Instance}" />
                                </StackPanel.Visibility>
                                <ItemsControl ItemsSource="{Binding SelectedCard.Dyes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}" Width="36" Height="36" Background="{Binding Fill}"
                                                    Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Channel}"
                                                    ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
                                                <Border CornerRadius="4" Padding="5,0" Background="#99000000" BorderThickness="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DisplayNumber}" Foreground="White" FontWeight="SemiBold" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SelectedChannelText}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <Button Content="Kleur van dit vlak verwijderen" Command="{Binding ClearDyeCommand}" Margin="0,8,0,8" Padding="8,4" />

                                <TextBox Text="{Binding ColorSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Zoek een kleur op naam" ToolTip="Zoek een kleur op naam" />
                                <ComboBox ItemsSource="{Binding Hues}" SelectedItem="{Binding SelectedHue, Mode=TwoWay}" Margin="0,8,0,0" Padding="6" AutomationProperties.Name="Kleurgroep" />
                                <CheckBox Content="Alleen kleuren die ik heb" IsChecked="{Binding ColorOwnedOnly, Mode=TwoWay}" Margin="0,8,0,0" />

                                <ListBox ItemsSource="{Binding VisibleColors}" Height="220" Margin="0,8,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Kleuren">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}" Background="{Binding Hex}"
                                                    Command="{Binding DataContext.ApplyDyeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Opgeslagen looks" Style="{StaticResource HeadingText}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Naam van de look" ToolTip="Naam van de look" />
                                <Button Grid.Column="1" Content="Opslaan" Style="{StaticResource PrimaryButton}" Command="{Binding SavePresetCommand}" Padding="12,6" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="Nog geen opgeslagen looks." Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPresets}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Laden" Padding="10,4"
                                                    Command="{Binding DataContext.LoadPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Content="Verwijderen" Padding="10,4" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Look van mijn karakter" Style="{StaticResource HeadingText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,8"
                                       Text="Haal op wat een van je karakters nu draagt. Daarvoor is je verbonden account nodig." />
                            <Button Content="Mijn karakters laden" Command="{Binding LoadCharactersCommand}" Padding="10,5" />
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Visibility>
                                    <Binding Path="HasCharacters" Converter="{x:Static local:VisibilityConverter.Instance}" />
                                </StackPanel.Visibility>
                                <ComboBox ItemsSource="{Binding CharacterNames}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" Padding="6" AutomationProperties.Name="Karakter" />
                                <Button Content="Gebruik deze look" Command="{Binding ImportCharacterCommand}" Margin="0,8,0,0" Padding="10,5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Alles leegmaken" Command="{Binding ResetLookCommand}" Padding="10,5" />
                        <Button Content="Onderdeel leegmaken" Command="{Binding ClearSelectedSlotCommand}" Padding="10,5" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button Content="Skins verversen" Command="{Binding RefreshCatalogCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="2,10,2,0" />
    </Grid>
</Window>
