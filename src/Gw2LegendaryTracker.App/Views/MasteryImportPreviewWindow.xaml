<Window x:Class="Gw2LegendaryTracker.App.Views.MasteryImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gw2LegendaryTracker.App.Views"
        Title="Masteryplan importeren"
        Width="520" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" FontSize="18" />
        <TextBlock Text="{Binding Summary}" Margin="0,4,0,0"
                   Visibility="{Binding HasSummary, Converter={x:Static local:VisibilityConverter.Instance}}" />

        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding CountsText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ChoicesText}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ReplaceText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasWarnings, Converter={x:Static local:VisibilityConverter.Instance}}">
            <TextBlock Text="{Binding WarningsHeading}" FontWeight="SemiBold" />
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Focusable="False">
                <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource MutedText}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuleren" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{Binding ConfirmText}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
