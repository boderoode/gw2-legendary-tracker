<Window x:Class="Gw2LegendaryTracker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gw2LegendaryTracker.App.Views"
        Title="GW2 Legendary Tracker"
        Width="720" Height="560" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="640">

            <TextBlock Text="Legendary Tracker" Style="{StaticResource HeadingText}" FontSize="24" />
            <TextBlock Margin="0,4,0,20" Style="{StaticResource MutedText}"
                       Text="Houd je Legendary-voortgang bij, in dit venster of in de overlay boven Guild Wars 2." />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Verbind je Guild Wars 2-account" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="De app leest alleen mee: zo weet hij welke materialen je al hebt. Er wordt niets in het spel gewijzigd." />

                    <StackPanel x:Name="ConnectForm">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsApiKey}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Margin="0,12,0,0">
                            <Run Text="1. Open" />
                            <Hyperlink NavigateUri="https://account.arena.net/applications" RequestNavigate="OnLinkNavigate">account.arena.net/applications</Hyperlink>
                            <Run Text="en log in." />
                        </TextBlock>
                        <TextBlock Text="2. Klik op &quot;New Key&quot; en geef de key een naam, bijvoorbeeld &quot;Legendary Tracker&quot;." Margin="0,2,0,0" />
                        <TextBlock Text="3. Zet een vinkje bij: account, inventories, characters en wallet. Meer is niet nodig." Margin="0,2,0,0" />
                        <TextBlock Text="4. Kopieer de key en plak hem hieronder." Margin="0,2,0,8" />

                        <PasswordBox x:Name="ApiKeyBox" Padding="8" FontSize="14" MaxLength="100"
                                     AutomationProperties.Name="API-key" KeyDown="OnApiKeyBoxKeyDown" />
                        <Button Content="Verbinden" Click="OnConnectClick" IsEnabled="{Binding IsNotBusy}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApiKey}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Nu synchroniseren" Command="{Binding SyncNowCommand}" />
                        <Button Content="Key verwijderen" Click="OnDisconnectClick" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding ConnectMessage}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConnectMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectMessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Recepten van de Legendaries" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="Het spel geeft de recepten van de Legendaries zelf (de Gifts en de Mystic Forge-stappen) niet vrij. De app haalt ze daarom op bij de website gw2treasures.com en controleert ze met de officiële gegevens. Daarvoor is een gratis key nodig." />

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecipeData.NeedsKey}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Margin="0,12,0,0">
                            <Run Text="1. Open" />
                            <Hyperlink NavigateUri="https://en.gw2treasures.com/dev/api" RequestNavigate="OnLinkNavigate">en.gw2treasures.com/dev/api</Hyperlink>
                            <Run Text="en log in (rechtsboven)." />
                        </TextBlock>
                        <TextBlock Text="2. Open in het menu bovenaan &quot;Developer&quot; en registreer een applicatie, bijvoorbeeld &quot;Legendary Tracker&quot;." Margin="0,2,0,0" />
                        <TextBlock Text="3. Kopieer de key die je krijgt en plak hem hieronder." Margin="0,2,0,8" />

                        <PasswordBox x:Name="ForgeKeyBox" Padding="8" FontSize="14" MaxLength="100"
                                     AutomationProperties.Name="gw2treasures-key" KeyDown="OnForgeKeyBoxKeyDown" />
                        <Button Content="Verbinden" Click="OnForgeConnectClick" IsEnabled="{Binding RecipeData.IsNotBusy}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecipeData.HasKey}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Recepten opnieuw ophalen" Command="{Binding RecipeData.RefreshCommand}"
                                ToolTip="Haalt de recepten van de gekozen Legendary opnieuw op, ook als ze recent zijn opgehaald." />
                        <Button Content="Key verwijderen" Click="OnForgeDisconnectClick" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding RecipeData.ConnectMessage}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecipeData.HasConnectMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RecipeData.ConnectMessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource SyncDot}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SyncText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mijn Legendaries" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="{Binding Goals.StatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding RecipeData.FetchText}" Style="{StaticResource MutedText}" Margin="0,2,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="RecipeData.HasFetchText" Converter="{x:Static local:VisibilityConverter.Instance}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock Text="{Binding RecipeData.Notice}" Style="{StaticResource MutedText}" Margin="0,2,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="RecipeData.HasNotice" Converter="{x:Static local:VisibilityConverter.Instance}" />
                        </TextBlock.Visibility>
                    </TextBlock>

                    <TextBlock Text="Voeg een Legendary toe" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Goals.AddSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Zoek een Legendary" ToolTip="Typ een deel van de naam, bijvoorbeeld Twilight" />
                    <ListBox ItemsSource="{Binding Goals.Suggestions}" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" ItemContainerStyle="{StaticResource PlainListBoxItem}"
                             Margin="0,4,0,0" AutomationProperties.Name="Zoekresultaten">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Goals.HasSuggestions}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconUrl}" Width="24" Height="24" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <Button Grid.Column="2" Content="Toevoegen" Padding="10,3"
                                            Command="{Binding DataContext.Goals.AddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Je hebt nog geen Legendary gekozen. Zoek er hierboven een en klik op Toevoegen." Style="{StaticResource MutedText}" Margin="0,12,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="Goals.HasNoGoals" Converter="{x:Static local:VisibilityConverter.Instance}" />
                        </TextBlock.Visibility>
                    </TextBlock>

                    <TextBlock Text="Volgorde = voorrang: een Legendary bovenaan krijgt eerst jouw materialen." Style="{StaticResource MutedText}" Margin="0,12,0,4">
                        <TextBlock.Visibility>
                            <Binding Path="Goals.HasGoals" Converter="{x:Static local:VisibilityConverter.Instance}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Goals.Rows}" SelectedValuePath="ItemId" SelectedValue="{Binding Goals.SelectedGoalId, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                             AutomationProperties.Name="Mijn Legendaries">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconUrl}" Width="24" Height="24" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Content="▲" Padding="6,2" ToolTip="Hogere voorrang" AutomationProperties.Name="Hogere voorrang"
                                                Command="{Binding DataContext.Goals.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Content="▼" Padding="6,2" Margin="4,0,0,0" ToolTip="Lagere voorrang" AutomationProperties.Name="Lagere voorrang"
                                                Command="{Binding DataContext.Goals.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Content="✕" Padding="6,2" Margin="4,0,0,0" ToolTip="Verwijderen" AutomationProperties.Name="Verwijderen"
                                                Command="{Binding DataContext.Goals.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Visibility>
                            <Binding Path="Goals.HasSelection" Converter="{x:Static local:VisibilityConverter.Instance}" />
                        </StackPanel.Visibility>

                        <TextBlock Text="{Binding Goals.SelectedName}" Style="{StaticResource HeadingText}" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Goals.SelectedProgress, Mode=OneWay}" Height="8" Margin="0,8,0,0"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BackgroundBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="Voortgang" />
                        <TextBlock Text="{Binding Goals.SelectedProgressText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Een onderdeel telt mee als je er genoeg van hebt, of als je het nu zelf kunt maken met wat je bezit." />

                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="6" Background="#33E0A526" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <Border.Visibility>
                                <Binding Path="Goals.HasRecipeNotice" Converter="{x:Static local:VisibilityConverter.Instance}" />
                            </Border.Visibility>
                            <TextBlock Text="{Binding Goals.RecipeNotice}" />
                        </Border>

                        <TextBlock Text="Volgende stap" Style="{StaticResource MutedText}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding Goals.NextStepText}" FontWeight="SemiBold" />

                        <TextBlock Text="Nog nodig" Style="{StaticResource MutedText}" Margin="0,12,0,2" />
                        <ItemsControl ItemsSource="{Binding Goals.Shortages}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding IconUrl}" Width="24" Height="24" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding Path="Goals.HasChecklist" Converter="{x:Static local:VisibilityConverter.Instance}" />
                            </StackPanel.Visibility>
                            <TextBlock Text="Onderdelen" Style="{StaticResource MutedText}" Margin="0,12,0,2" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Vink een onderdeel aan als je het al hebt gemaakt of gekregen, ook als de app het niet in je inventaris ziet." />
                            <ItemsControl ItemsSource="{Binding Goals.Checklist}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                            <Image Grid.Column="1" Source="{Binding IconUrl}" Width="24" Height="24" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Notitie" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Goals.SelectedNote, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="48" MaxLength="2000" AutomationProperties.Name="Notitie bij deze Legendary" />
                    </StackPanel>

                    <TextBlock Text="{Binding Goals.ErrorText}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="Goals.HasError" Converter="{x:Static local:VisibilityConverter.Instance}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                </StackPanel>
            </Border>


            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Wat heb ik?" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="{Binding Inventory.StatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                    <TextBox Text="{Binding Inventory.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Zoek in je spullen" ToolTip="Typ een deel van een itemnaam" />
                    <ListBox ItemsSource="{Binding Inventory.VisibleRows}" MaxHeight="320" Margin="0,8,0,0"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                             ItemContainerStyle="{StaticResource PlainListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Lijst met je spullen">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconUrl}" Width="24" Height="24" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding WhereText}" Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Overlay" Style="{StaticResource HeadingText}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                        <Button Content="Overlay tonen/verbergen" Command="{Binding ToggleOverlayCommand}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}">
                            <Run Text="Sneltoets:" />
                            <Run Text="{Binding HotkeyText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyError, StringFormat=Sneltoets niet beschikbaar: {0}}"
                               Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHotkeyError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Transparantie" Margin="0,16,0,4" Style="{StaticResource MutedText}" />
                    <Slider Minimum="0.2" Maximum="1" LargeChange="0.1" SmallChange="0.05" TickFrequency="0.1"
                            Value="{Binding Opacity, Mode=TwoWay}" AutomationProperties.Name="Transparantie van de overlay" />

                    <CheckBox Content="Overlay uitgebreid weergeven" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Margin="0,12,0,4" />
                    <TextBlock Margin="0,12,0,4" Style="{StaticResource MutedText}">
                        <Run Text="Aantal materialen in de compacte overlay:" />
                        <Run Text="{Binding VisibleMaterialCount, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="3"
                            Value="{Binding VisibleMaterialCount, Mode=TwoWay}"
                            AutomationProperties.Name="Aantal materialen in de compacte overlay" />
                    <CheckBox Content="Uitgebreide overlay: alleen ontbrekende materialen tonen" IsChecked="{Binding OverlayShowOnlyMissing, Mode=TwoWay}" Margin="0,8,0,0" />
                    <CheckBox Content="Overlay vergrendelen tegen verslepen" IsChecked="{Binding IsLocked, Mode=TwoWay}" />
                    <CheckBox Content="Overlay automatisch tonen bij het starten" IsChecked="{Binding ShowOverlayOnStartup, Mode=TwoWay}" />
                    <CheckBox Content="Overlay automatisch verbergen na 10 seconden" IsChecked="{Binding AutoHideEnabled, Mode=TwoWay}" />
                    <CheckBox Content="Click-through: muisklikken gaan door de overlay heen" IsChecked="{Binding IsClickThrough, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="24,0,0,0"
                               Text="Met click-through aan kun je de overlay niet aanklikken. Zet het hier weer uit, of verberg de overlay met de sneltoets." />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="12" CornerRadius="6" Background="#33E5605A" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
